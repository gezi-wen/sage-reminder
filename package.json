{
  "name": "sage-reminder",
  "version": "0.1.2",
  "description": "时间提醒（reminder）— DSH 会话头部的时间模块：现在时间 / 距上次发言 / 提醒 / 倒计时。定位是会话内的短期提醒（纯 client 半，数据存浏览器本地）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "react": "^18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gezi-wen/sage-reminder.git"
  },
  "homepage": "https://github.com/gezi-wen/sage-reminder#readme",
  "bugs": {
    "url": "https://github.com/gezi-wen/sage-reminder/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "plugin",
    "web-ui",
    "header-widget",
    "clock",
    "reminder",
    "alarm",
    "countdown",
    "timer",
    "session-timer",
    "time-tracking"
  ]
}
